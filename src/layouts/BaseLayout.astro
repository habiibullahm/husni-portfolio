---
import '../styles/global.css';

interface Props { title?: string; description?: string }
const {
  title = 'Husni Attin | Patient Admission & Healthcare Administration | Jakarta',
  description = 'Husni Attin is a Jakarta-based Patient Admission and Healthcare Administration professional with experience in outpatient registration, ODC pre-admission, insurance verification, reporting, and patient service.',
} = Astro.props;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
import { profile } from '../data/profile';
const personSchema = {
  '@context': 'https://schema.org', '@type': 'Person', name: 'Husni Attin',
  jobTitle: 'Admission / Frontliner', worksFor: { '@type': 'Organization', name: 'Bidakara Medical Center' },
  alumniOf: { '@type': 'EducationalOrganization', name: 'Poltekkes Kemenkes Jakarta II' },
  knowsAbout: ['Healthcare Administration', 'Environmental Health', 'Public Health', 'Patient Admission', 'Healthcare Service'],
  sameAs: [profile.linkedin], address: { '@type': 'PostalAddress', addressLocality: 'Jakarta', addressCountry: 'ID' },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f2ea" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {Astro.site && <link rel="sitemap" href={new URL('sitemap-index.xml', Astro.site)} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {Astro.site && <meta property="og:image" content={new URL('/og/husni-attin-og.jpg', Astro.site)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {Astro.site && <meta name="twitter:image" content={new URL('/og/husni-attin-og.jpg', Astro.site)} />}
    <script type="application/ld+json" set:html={JSON.stringify(personSchema).replace(/</g, '\\u003c')} />
    <title>{title}</title>
  </head>
  <body><slot /></body>
</html>
